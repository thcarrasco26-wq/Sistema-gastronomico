    // =========================================================
    // CARGAR PRODUCTOS
    // =========================================================

    private void cargarProductos() {

        cmbProducto.removeAllItems();

        String sql = "SELECT id_producto, nombre FROM productos ORDER BY nombre";

        try (Connection cn = Conexion.conectar();
             Statement st = cn.createStatement();
             ResultSet rs = st.executeQuery(sql)) {

            while (rs.next()) {

                cmbProducto.addItem(
                        rs.getInt("id_producto") +
                        " - " +
                        rs.getString("nombre")
                );
            }

            mostrarPrecio();

        } catch (SQLException ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Error al cargar productos: " + ex.getMessage()
            );
        }
    }

    // =========================================================
    // MOSTRAR PRECIO
    // =========================================================

    private void mostrarPrecio() {

        if (cmbProducto.getSelectedItem() == null) {
            lblPrecio.setText("0.00");
            return;
        }

        String seleccionado =
                cmbProducto.getSelectedItem().toString();

        int id =
                Integer.parseInt(
                        seleccionado.split(" - ")[0]
                );

        String sql =
                "SELECT precio FROM productos WHERE id_producto=?";

        try (Connection cn = Conexion.conectar();
             PreparedStatement ps = cn.prepareStatement(sql)) {

            ps.setInt(1, id);

            ResultSet rs = ps.executeQuery();

            if (rs.next()) {

                lblPrecio.setText(
                        String.format("%.2f", rs.getDouble("precio"))
                );
            }

        } catch (SQLException ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Error al obtener precio: " + ex.getMessage()
            );
        }
    }

    // =========================================================
    // AGREGAR PRODUCTO
    // =========================================================

    private void agregarProducto() {

        if (cmbProducto.getSelectedItem() == null) {

            JOptionPane.showMessageDialog(
                    this,
                    "Selecciona un producto."
            );

            return;
        }

        try {

            int cantidad =
                    Integer.parseInt(txtCantidad.getText());

            if (cantidad <= 0) {

                JOptionPane.showMessageDialog(
                        this,
                        "La cantidad debe ser mayor a 0."
                );

                return;
            }

            String seleccionado =
                    cmbProducto.getSelectedItem().toString();

            int idProducto =
                    Integer.parseInt(
                            seleccionado.split(" - ")[0]
                    );

            String nombreProducto =
                    seleccionado.substring(
                            seleccionado.indexOf(" - ") + 3
                    );

            double precio =
                    Double.parseDouble(lblPrecio.getText());

            double subtotal =
                    precio * cantidad;

            modeloDetalle.addRow(new Object[]{
                    idProducto,
                    nombreProducto,
                    cantidad,
                    precio,
                    subtotal
            });

            total += subtotal;

            lblTotal.setText(
                    String.format("S/ %.2f", total)
            );

            txtCantidad.setText("");

        } catch (NumberFormatException ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Ingresa una cantidad válida."
            );
        }
    }

    // =========================================================
    // ELIMINAR PRODUCTO
    // =========================================================

    private void eliminarProducto() {

        int fila = tablaDetalle.getSelectedRow();

        if (fila == -1) {

            JOptionPane.showMessageDialog(
                    this,
                    "Selecciona un producto."
            );

            return;
        }

        double subtotal =
                Double.parseDouble(
                        modeloDetalle.getValueAt(fila, 4).toString()
                );

        total -= subtotal;

        modeloDetalle.removeRow(fila);

        lblTotal.setText(
                String.format("S/ %.2f", total)
        );
    }

    // =========================================================
    // REGISTRAR PEDIDO
    // =========================================================

    private void registrarPedido() {

        if (modeloDetalle.getRowCount() == 0) {

            JOptionPane.showMessageDialog(
                    this,
                    "Agrega al menos un producto."
            );

            return;
        }

        Connection cn = null;

        try {

            cn = Conexion.conectar();
            cn.setAutoCommit(false);

            String sqlPedido =
                    "INSERT INTO pedidos (estado, total) " +
                    "VALUES ('Pendiente', ?)";

            PreparedStatement psPedido =
                    cn.prepareStatement(
                            sqlPedido,
                            Statement.RETURN_GENERATED_KEYS
                    );

            psPedido.setDouble(1, total);
            psPedido.executeUpdate();

            ResultSet rs =
                    psPedido.getGeneratedKeys();

            int idPedido = 0;

            if (rs.next()) {
                idPedido = rs.getInt(1);
            }

            String sqlDetalle =
                    "INSERT INTO detalle_pedido " +
                    "(id_pedido, id_producto, cantidad, precio, subtotal) " +
                    "VALUES (?, ?, ?, ?, ?)";

            PreparedStatement psDetalle =
                    cn.prepareStatement(sqlDetalle);

            for (int i = 0;
                 i < modeloDetalle.getRowCount();
                 i++) {

                int idProducto =
                        Integer.parseInt(
                                modeloDetalle.getValueAt(i, 0).toString()
                        );

                int cantidad =
                        Integer.parseInt(
                                modeloDetalle.getValueAt(i, 2).toString()
                        );

                double precio =
                        Double.parseDouble(
                                modeloDetalle.getValueAt(i, 3).toString()
                        );

                double subtotal =
                        Double.parseDouble(
                                modeloDetalle.getValueAt(i, 4).toString()
                        );

                psDetalle.setInt(1, idPedido);
                psDetalle.setInt(2, idProducto);
                psDetalle.setInt(3, cantidad);
                psDetalle.setDouble(4, precio);
                psDetalle.setDouble(5, subtotal);

                psDetalle.executeUpdate();
            }

            cn.commit();

            JOptionPane.showMessageDialog(
                    this,
                    "¡Pedido registrado correctamente!\n\n" +
                    "N.º de pedido: " + idPedido +
                    "\nEstado: Pendiente" +
                    "\nTotal: S/ " +
                    String.format("%.2f", total)
            );

            limpiarPedido();

            cargarPedidos();

        } catch (SQLException ex) {

            try {
                if (cn != null) {
                    cn.rollback();
                }
            } catch (SQLException e) {
                e.printStackTrace();
            }

            JOptionPane.showMessageDialog(
                    this,
                    "Error al registrar pedido:\n" +
                    ex.getMessage(),
                    "Error",
                    JOptionPane.ERROR_MESSAGE
            );

        } finally {

            try {
                if (cn != null) {
                    cn.setAutoCommit(true);
                    cn.close();
                }
            } catch (SQLException e) {
                e.printStackTrace();
            }
        }
    }

    // =========================================================
    // CARGAR PEDIDOS REGISTRADOS
    // =========================================================

    private void cargarPedidos() {

        modeloPedidos.setRowCount(0);

        String sql =
                "SELECT id_pedido, fecha, estado, total " +
                "FROM pedidos " +
                "ORDER BY id_pedido DESC";

        try (Connection cn = Conexion.conectar();
             Statement st = cn.createStatement();
             ResultSet rs = st.executeQuery(sql)) {

            while (rs.next()) {

                modeloPedidos.addRow(new Object[]{
                        rs.getInt("id_pedido"),
                        rs.getTimestamp("fecha"),
                        rs.getString("estado"),
                        "S/ " +
                        String.format(
                                "%.2f",
                                rs.getDouble("total")
                        )
                });
            }

        } catch (SQLException ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Error al cargar pedidos: " +
                    ex.getMessage(),
                    "Error",
                    JOptionPane.ERROR_MESSAGE
            );
        }
    }

    // =========================================================
    // CAMBIAR ESTADO
    // =========================================================

    private void cambiarEstado(String nuevoEstado) {

        int fila = tablaPedidos.getSelectedRow();

        if (fila == -1) {

            JOptionPane.showMessageDialog(
                    this,
                    "Selecciona un pedido de la tabla."
            );

            return;
        }

        int idPedido =
                Integer.parseInt(
                        modeloPedidos.getValueAt(fila, 0).toString()
                );

        String sql =
                "UPDATE pedidos SET estado=? WHERE id_pedido=?";

        try (Connection cn = Conexion.conectar();
             PreparedStatement ps = cn.prepareStatement(sql)) {

            ps.setString(1, nuevoEstado);
            ps.setInt(2, idPedido);

            ps.executeUpdate();

            JOptionPane.showMessageDialog(
                    this,
                    "Estado actualizado a: " + nuevoEstado
            );

            cargarPedidos();

        } catch (SQLException ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Error al actualizar estado: " +
                    ex.getMessage()
            );
        }
    }

    // =========================================================
    // LIMPIAR PEDIDO NUEVO
    // =========================================================

    private void limpiarPedido() {

        modeloDetalle.setRowCount(0);

        total = 0;

        lblTotal.setText("S/ 0.00");

        txtCantidad.setText("");

        if (cmbProducto.getItemCount() > 0) {
            cmbProducto.setSelectedIndex(0);
        }
    }

